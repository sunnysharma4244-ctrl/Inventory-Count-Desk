{
  "name": "inventory-count-desk",
  "version": "1.0.0",
  "description": "Inventory Count Desk Desktop App",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.inventory.countdesk",
    "productName": "Inventory Count Desk",
    "asar": true,
    "compression": "maximum",
    "files": [
      "index.html",
      "main.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inventory Count Desk"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
